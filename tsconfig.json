{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["web-bluetooth", "w3c-web-serial", "vite/client", "vite-plugin-pwa/client", "node"],
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"isolatedModules": true
	},
	"include": ["src", "test", "vite.config.ts"]
}
